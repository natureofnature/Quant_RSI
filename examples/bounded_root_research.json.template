{
  "schema_version": 2,
  "plan_type": "development_research",
  "development": {
    "schema_version": 1,
    "plan_type": "development",
    "training_mode": "M0",
    "data": {
      "source": "local_event_snapshot",
      "sessions": "SET_REGISTERED_PREFIX_SESSION_COUNT",
      "instruments": "SET_REGISTERED_INSTRUMENT_COUNT",
      "train_cutoff": "SET_ZERO_BASED_CUTOFF_INDEX",
      "seed": 7,
      "snapshot_ref": "SET_IMPORTED_SNAPSHOT_SHA256",
      "decision_delay_seconds": "SET_HISTORICAL_DECISION_DELAY_SECONDS"
    },
    "portfolio": {
      "currency": "SET_CURRENCY",
      "currency_precision": "SET_INTEGER_CURRENCY_PRECISION",
      "rounding_policy": "half_even_per_component",
      "initial_cash": "SET_INITIAL_CASH",
      "cash_settlement": "immediate_simulation",
      "inventory_unlock": "immediate_simulation",
      "sizing": "long_only_topk",
      "allocation": "SET_ALLOCATION_FRACTION",
      "max_positions": "SET_MAX_POSITIONS",
      "lot_size": "SET_POSITIVE_INTEGER_LOT",
      "cost_policy": "linear_side_bps",
      "buy_costs": {
        "commission_bps": "SET_EXPLICIT_DECIMAL_BPS",
        "tax_bps": "SET_EXPLICIT_DECIMAL_BPS",
        "slippage_bps": "SET_EXPLICIT_DECIMAL_BPS"
      },
      "sell_costs": {
        "commission_bps": "SET_EXPLICIT_DECIMAL_BPS",
        "tax_bps": "SET_EXPLICIT_DECIMAL_BPS",
        "slippage_bps": "SET_EXPLICIT_DECIMAL_BPS"
      },
      "cost_claim": "explicit_observation_assumption",
      "fill_policy": "next_registered_open_market",
      "fill_cap_units": {
        "SET_INSTRUMENT_ID": "SET_POSITIVE_UNIT_CAP_MULTIPLE_OF_LOT"
      },
      "funding_policy": "pre_funded_no_unfilled_sale_credit",
      "valuation": "close_fresh_quote_only",
      "benchmark": "cash_zero_interest",
      "action_policy": "notice_suspend_unresolved",
      "termination": "preserve_inventory",
      "stop_policy": "cancel_unelapsed_targets",
      "max_drawdown": "SET_DRAWDOWN_FRACTION"
    },
    "budget": {
      "max_attempts": 8,
      "worker_timeout_seconds": 20,
      "max_worker_seconds": 160
    },
    "annualization": 252,
    "primary_metric": "annualized_mean_net_active_return",
    "min_development_sessions": 10,
    "baseline": "registered_baseline",
    "proposals": [
      {
        "name": "registered_baseline",
        "hypothesis": "Preregistered baseline for the bounded development experiment.",
        "factor": {
          "op": "momentum",
          "window": "SET_REGISTERED_BASELINE_WINDOW"
        }
      }
    ]
  },
  "policy": {
    "algorithm": "neighbor_search_v1",
    "window_min": "SET_GLOBAL_WINDOW_MIN",
    "window_max": "SET_INITIAL_WINDOW_CAP",
    "min_improvement": 0.0,
    "max_no_progress": 3,
    "neighbor_order": "window_first"
  },
  "neighbor_domain": {
    "kind": "RegisteredNeighborDomain",
    "schema_version": 1,
    "operators": [
      "momentum",
      "mean_return"
    ],
    "window_min": "SET_GLOBAL_WINDOW_MIN",
    "window_max": "SET_GLOBAL_WINDOW_MAX",
    "initial_window_max": "SET_INITIAL_WINDOW_CAP",
    "cap_step": 1,
    "max_cap_advances": 2
  },
  "trajectory_registration": {
    "kind": "TrajectoryRegistration",
    "schema_version": 1,
    "workspace": "SET_CANONICAL_ABSOLUTE_WORKSPACE",
    "source_directory": "SET_CANONICAL_ABSOLUTE_ROOT_SOURCE",
    "worker_attempts": "SET_TOTAL_ATTEMPT_LIMIT_BEFORE_GEN0",
    "registered_worker_seconds": "SET_TOTAL_SECOND_LIMIT_BEFORE_GEN0",
    "max_proposal_stages": 2,
    "max_generations": 2
  }
}
