{
  "schema_version": 1,
  "kind": "instrument_factor_config",
  "market": "US",
  "instrument": "CALM",
  "catalogs": ["equities"],
  "definitions": [
    {
      "factor_id": "calm.egg_price_momentum_5",
      "description": "Five-session momentum of the USDA AMS national FOB caged white-large shell-egg index. The report date is visible on the next target session.",
      "kind": "numeric",
      "input_kind": "positive_price_series",
      "recipe": {"op": "momentum", "window": 5}
    },
    {
      "factor_id": "calm.confirmed_layer_culls",
      "description": "Proposed extraction of confirmed layer culls relevant to egg supply; not a pre-outbreak disease predictor.",
      "kind": "text",
      "extraction_instruction": "Extract only confirmed HPAI-related layer culls, their region and reported count. Distinguish layers from other birds, unknown quantities from zero, and retain the supporting passage.",
      "output_fields": ["region", "bird_type", "confirmed_count", "unit", "evidence_text"]
    },
    {
      "factor_id": "calm.table_egg_layers_momentum_20",
      "description": "Twenty-session momentum of the NASS national average table-egg layer inventory. Visible from Quick Stats load_time, not the reference month. A later database reload is not a historical vintage.",
      "kind": "numeric",
      "input_kind": "positive_price_series",
      "recipe": {"op": "momentum", "window": 20}
    },
    {
      "factor_id": "calm.egg_type_pullets_momentum_20",
      "description": "Twenty-session momentum of NASS national egg-type pullet placements. Visible from Quick Stats load_time, not the reference month. A later database reload is not a historical vintage.",
      "kind": "numeric",
      "input_kind": "positive_price_series",
      "recipe": {"op": "momentum", "window": 20}
    },
    {
      "factor_id": "calm.egg_type_chicks_hatched_momentum_20",
      "description": "Twenty-session momentum of NASS national egg-type chicks hatched. Visible from Quick Stats load_time, not the reference month. A later database reload is not a historical vintage.",
      "kind": "numeric",
      "input_kind": "positive_price_series",
      "recipe": {"op": "momentum", "window": 20}
    },
    {
      "factor_id": "calm.corn_momentum_5",
      "description": "Five-session momentum of the CBOT corn future. The session uses that day's close, carried at most six calendar days.",
      "kind": "numeric",
      "input_kind": "positive_price_series",
      "recipe": {"op": "momentum", "window": 5}
    },
    {
      "factor_id": "calm.meal_momentum_5",
      "description": "Five-session momentum of the CBOT soybean-meal future. The session uses that day's close, carried at most six calendar days.",
      "kind": "numeric",
      "input_kind": "positive_price_series",
      "recipe": {"op": "momentum", "window": 5}
    },
    {
      "factor_id": "calm.feed_index_momentum_5",
      "description": "Five-session momentum of an equal-weight corn and soybean-meal index. Each leg is rebased to 100 on the first overlapping day.",
      "kind": "numeric",
      "input_kind": "positive_price_series",
      "recipe": {"op": "momentum", "window": 5}
    },
    {
      "factor_id": "calm.gas_momentum_5",
      "description": "Five-session momentum of the Henry Hub natural-gas future.",
      "kind": "numeric",
      "input_kind": "positive_price_series",
      "recipe": {"op": "momentum", "window": 5}
    },
    {
      "factor_id": "calm.mxn_momentum_5",
      "description": "Five-session momentum of the dollar-peso rate.",
      "kind": "numeric",
      "input_kind": "positive_price_series",
      "recipe": {"op": "momentum", "window": 5}
    },
    {
      "factor_id": "calm.diesel_momentum_5",
      "description": "Five-session momentum of weekly U.S. on-highway diesel. The price date is hidden that day and carried at most ten calendar days.",
      "kind": "numeric",
      "input_kind": "positive_price_series",
      "recipe": {"op": "momentum", "window": 5}
    },
    {
      "factor_id": "calm.effr_momentum_5",
      "description": "Five-session momentum of the effective federal funds rate. The effective date is hidden that day.",
      "kind": "numeric",
      "input_kind": "positive_price_series",
      "recipe": {"op": "momentum", "window": 5}
    },
    {
      "factor_id": "calm.drought_momentum_20",
      "description": "Twenty-session momentum of the share of the contiguous United States in moderate drought or worse. This is not a corn-belt index.",
      "kind": "numeric",
      "input_kind": "positive_price_series",
      "recipe": {"op": "momentum", "window": 20}
    },
    {
      "factor_id": "calm.easter_momentum_20",
      "description": "Twenty-session momentum of the days until the next Easter, plus one so the holiday itself stays positive.",
      "kind": "numeric",
      "input_kind": "positive_price_series",
      "recipe": {"op": "momentum", "window": 20}
    },
    {
      "factor_id": "calm.thanksgiving_momentum_20",
      "description": "Twenty-session momentum of the days until the next Thanksgiving, plus one so the holiday itself stays positive.",
      "kind": "numeric",
      "input_kind": "positive_price_series",
      "recipe": {"op": "momentum", "window": 20}
    }
  ],
